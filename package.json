{
   "name": "quickfolio",
   "private": true,
   "version": "0.1.0",
   "type": "module",
   "engines": {
      "node": "^20.19.0 || ^22.13.0 || >=24"
   },
   "scripts": {
      "dev": "vite",
      "build": "tsc && vite build",
      "preview": "vite preview",
      "test": "vitest run",
      "typecheck": "tsc",
      "lint": "eslint .",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "fix": "eslint --fix . ; prettier --write . && eslint .",
      "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
   },
   "devDependencies": {
      "@eslint/js": "^10.0.1",
      "@happy-dom/global-registrator": "^21.0.4",
      "@stylistic/eslint-plugin": "^5.10.0",
      "@types/node": "^22.20.5",
      "eslint": "^10.14.0",
      "prettier": "^3.9.10",
      "typescript": "^5.8.0",
      "typescript-eslint": "^8.72.1",
      "vite": "^7.0.0",
      "vitest": "^5.1.0"
   }
}
